<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.7.2 ships with Windows 10 1803+ / Windows 11, so the
         launcher needs no runtime installation and no download page. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The tray icon and the folder picker are WinForms; both ship with Windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010 asks to move DPI setup into ApplicationConfiguration, but this is
         a WPF app that only borrows NotifyIcon, so app.manifest stays in charge. -->
    <!-- CS8601..CS8604: .NET Framework's reference assemblies carry no nullable
         annotations, so string.IsNullOrWhiteSpace/IsNullOrEmpty do not narrow the
         null-state and the compiler reports ~30 false positives. The same sources
         compile warning-free against the annotated .NET 8 reference assemblies. -->
    <NoWarn>$(NoWarn);WFAC010;CS8601;CS8602;CS8603;CS8604</NoWarn>

    <AssemblyName>BagaGame</AssemblyName>
    <RootNamespace>BagaGame</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\bagagame.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <Authors>BagaGame</Authors>
    <Product>BagaGame</Product>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds net472 without a Visual Studio installation. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The in-box framework has no JSON serializer for this API surface. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not referenced implicitly on .NET Framework. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\bagagame.ico" />
  </ItemGroup>

  <!-- WinForms ships implicit usings that collide with the WPF ones
       (Application, MessageBox, Point, Size ...). Only the tray icon needs
       WinForms, so those two are used with explicit names instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
