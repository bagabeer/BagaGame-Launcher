<ui:BagaWindow x:Class="BagaGame.Views.SteamAchievementsWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:BagaGame.Controls"
               Title="{DynamicResource Loc.Achievements.Title}"
               Width="820"
               Height="720"
               MinWidth="560"
               MinHeight="440"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False"
               FontFamily="Segoe UI Variable Text, Segoe UI"
               FontSize="13"
               Foreground="{DynamicResource TextPrimaryBrush}"
               TextOptions.TextFormattingMode="Ideal"
               SnapsToDevicePixels="True"
               UseLayoutRounding="True"
               PreviewKeyDown="Window_PreviewKeyDown">

    <ui:BagaWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Rounded track so the bar matches the cards instead of the system look. -->
        <Style x:Key="AchievementProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:BagaWindow.Resources>

    <Grid Background="{DynamicResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Draggable caption area; the window buttons live in TitleBar.xaml. -->
        <ui:TitleBar Grid.Row="0" Height="48" Background="Transparent" />

        <Grid Grid.Row="1" Margin="28,8,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: icon, eyebrow, game title and progress. -->
            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="46"
                            Height="46"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ui:SymbolIcon Symbol="Certificate24"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{DynamicResource Loc.Achievements.Title}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding GameTitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ProgressText}" />

                    <Border Grid.Column="1"
                            Padding="9,3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ChipFillBrush}"
                            CornerRadius="8"
                            Visibility="{Binding HasLocalSource, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding SourceText}" />
                    </Border>
                </Grid>

                <ProgressBar Margin="0,10,0,0"
                             Style="{StaticResource AchievementProgressBar}"
                             Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                             Value="{Binding UnlockedCount, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ChipFillBrush}"
                             BorderThickness="0" />
            </StackPanel>

            <!-- Achievement list or an empty state card. -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <ScrollViewer Style="{DynamicResource OverlayScrollViewer}"
                              Padding="0,0,14,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Achievements}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="12,10"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardFillHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ChipFillBrush}"
                                                CornerRadius="0"
                                                ClipToBounds="True">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Padding="9,4"
                                                    Background="{DynamicResource ChipFillBrush}"
                                                    CornerRadius="8">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ChipFillBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Cursor="Help"
                                                    ToolTip="{Binding UnlockTimeText}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnlockTime}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Canvas Width="10"
                                                        Height="10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Ellipse Canvas.Left="0"
                                                             Canvas.Top="0"
                                                             Width="10"
                                                             Height="10"
                                                             Stroke="{DynamicResource TextSecondaryBrush}"
                                                             StrokeThickness="1" />
                                                    <Line X1="5"
                                                          Y1="5"
                                                          X2="5"
                                                          Y2="2.2"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                    <Line X1="5"
                                                          Y1="5"
                                                          X2="7.1"
                                                          Y2="5.9"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Border>

                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ChipFillBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Cursor="Help"
                                                    ToolTip="{Binding GlobalPercentText}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="?" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border MaxWidth="480"
                        Padding="26,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardFillBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAchievements}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <ui:SymbolIcon Margin="0,0,0,10"
                                       Symbol="Certificate24"
                                       FontSize="26"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding StatusText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:BagaButton Margin="0,0,10,0"
                               Padding="18,8"
                               Click="Refresh_Click"
                               Content="{DynamicResource Loc.Achievements.Refresh}" />
                <ui:BagaButton Padding="18,8"
                               Appearance="Primary"
                               Click="Close_Click"
                               Content="{DynamicResource Loc.Achievements.Close}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:BagaWindow>
