<Window x:Class="BagaGame.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BagaGame.Controls"
        Title="BagaGame"
        Width="460"
        Height="290"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Border Margin="14"
            Background="{DynamicResource BpPanelBrush}"
            BorderBrush="{DynamicResource BpBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="Logo"
                    Width="92"
                    Height="92"
                    Background="{DynamicResource LogoBrush}"
                    CornerRadius="26"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                                      Direction="270"
                                      Opacity="0.55"
                                      ShadowDepth="0"
                                      Color="#8CE85B" />
                </Border.Effect>
                <ui:SymbolIcon FontSize="46"
                               Foreground="#13200C"
                               Symbol="Gamepad24" />
            </Border>

            <TextBlock Margin="0,22,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BpTextBrush}"
                       Text="BagaGame" />

            <TextBlock Margin="1,6,0,0"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BpTextMutedBrush}"
                       Text="GAME LAUNCHER" />

            <Border Margin="0,26,0,0"
                    Width="120"
                    Height="3"
                    Background="{DynamicResource BpKeyCapBrush}"
                    CornerRadius="2">
                <Border x:Name="Progress"
                        Width="42"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource BpAccentBrush}"
                        CornerRadius="2" />
            </Border>
        </StackPanel>
    </Border>
</Window>
