<Window x:Class="BagaGame.Views.BigPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BagaGame.Controls"
        Title="BagaGame Big Picture"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BpBackgroundBrush}"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- ============================== Buttons ============================ -->

        <Style x:Key="BpPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BpAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BpAccentForegroundBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource BpAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BpSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BpSecondaryFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BpTextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="26,13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource BpSecondaryHoverBrush}" />
                                <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource BpBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BpIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource BpNavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Navigation =========================== -->

        <Style x:Key="BpNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BpTextMutedBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Padding="16,13"
                                Background="Transparent"
                                CornerRadius="12">
                            <Grid>
                                <Border x:Name="Bar"
                                        Width="4"
                                        Height="20"
                                        Margin="-10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BpAccentBrush}"
                                        CornerRadius="2"
                                        Opacity="0" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="Glyph"
                                                   FontSize="20"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Symbol="{TemplateBinding Tag}" />
                                    <ContentPresenter Margin="14,0,0,0"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BpNavHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BpAccentSoftBrush}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== Hints ============================== -->

        <Style x:Key="BpKeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BpKeyCapBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BpKeyCapStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
        </Style>

        <Style x:Key="BpHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource BpTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PadBadge" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource BpPadBadgeBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="PadBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource BpPadBadgeTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Hint glyphs based on Material Icons (Apache 2.0). -->
        <Geometry x:Key="BpGlyphSwap">M6.99,11 3,15l3.99,4v-3H14v-2H6.99v-3zM21,9l-3.99-4v3H10v2h7.01v3L21,9z</Geometry>
        <Geometry x:Key="BpGlyphEnter">M19,7v4H5.83l3.58-3.59L8,6l-6,6 6,6 1.41-1.41L5.83,13H21V7z</Geometry>
        <Geometry x:Key="BpGlyphSpace">M18,9v4H6V9H4v6h16V9z</Geometry>
        <Geometry x:Key="BpGlyphDown">M7.41,8.59 12,13.17l4.59-4.58L18,10l-6,6-6-6 1.41-1.41z</Geometry>
        <Geometry x:Key="BpGlyphMenu">M3,18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z</Geometry>
        <Geometry x:Key="BpGlyphExit">m17,7-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5zM4,5h8V3H4c-1.1,0-2,0.9-2,2v14c0,1.1,0.9,2,2,2h8v-2H4V5z</Geometry>
        <Geometry x:Key="BpGlyphBumper">M3,7 C3,4.8 4.8,3 7,3 H23 C25.2,3 27,4.8 27,7 V13 C27,15.2 25.2,17 23,17 H17.5 C16.7,17 16,16.3 16,15.5 C16,16.3 15.3,17 14.5,17 H7 C4.8,17 3,15.2 3,13 Z</Geometry>

        <Style x:Key="BpHintGlyph" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource BpTextBrush}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BpPadGlyph" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource BpPadBadgeTextBrush}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Grouping pills above the hero title, switched with LB/RB. -->
        <Style x:Key="BpGroupPill" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource BpTextMutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BpNavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource BpAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BpAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Genre filter chips under the hero. -->
        <Style x:Key="BpGenrePill" TargetType="ListBoxItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="{DynamicResource BpTextMutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BpNavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource BpAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BpAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BpAccentSoftBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BpArrowButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource BpHeroPanelBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BpNavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BpShoulderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BpTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <!-- The whole layout is designed for 1080p and scaled by the screen height. -->
    <Grid x:Name="Root" Background="{DynamicResource BpBackgroundBrush}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Sidebar =========================== -->

        <Border Grid.Column="0"
                Margin="0,0,-1,0"
                Panel.ZIndex="1"
                Background="{DynamicResource BpSidebarBrush}"
                BorderBrush="{DynamicResource BpDividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="26,30,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="52"
                            Height="52"
                            Background="{DynamicResource LogoBrush}"
                            CornerRadius="15">
                        <ui:SymbolIcon FontSize="26"
                                       Foreground="#13200C"
                                       Symbol="Gamepad24" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BpTextBrush}"
                                   Text="BagaGame" />
                        <TextBlock Margin="1,3,0,0"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="GAME LAUNCHER" />
                    </StackPanel>
                </StackPanel>

                <!-- Section label. Navigation lives in the list itself; the only
                     other destinations (scan, settings) stay in the main window
                     because they are awkward on a controller. -->
                <StackPanel Grid.Row="1" Margin="0,40,0,0">
                    <Border Padding="16,13"
                            Background="{DynamicResource BpAccentSoftBrush}"
                            CornerRadius="12">
                        <Grid>
                            <Border Width="4"
                                    Height="20"
                                    Margin="-10,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource BpAccentBrush}"
                                    CornerRadius="2" />
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="20"
                                               Foreground="{DynamicResource BpTextBrush}"
                                               Symbol="Library24" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{DynamicResource BpTextBrush}"
                                           Text="{DynamicResource Loc.Nav.Library}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Status card -->
                <Border Grid.Row="2"
                        Padding="16,14"
                        Background="{DynamicResource BpCardBrush}"
                        CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource BpTextBrush}"
                                       Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Margin="17,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{Binding GamesCountText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =============================== Content ========================== -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero banner -->

            <Grid Grid.Row="0" ClipToBounds="True">
                <Image Source="{Binding SelectedCover}"
                       Stretch="UniformToFill"
                       Opacity="0.5"
                       RenderOptions.BitmapScalingMode="LowQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.9" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                    <Image.Effect>
                        <BlurEffect KernelType="Gaussian" Radius="92" />
                    </Image.Effect>
                </Image>

                <!-- Wide store artwork; the poster above stays as a fallback. -->
                <Image Source="{Binding HeroImage}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.9" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHero}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Left-to-right shade keeps the text readable on bright art. -->
                <Rectangle Fill="{DynamicResource BpHeroLeftFadeBrush}" />

                <!-- Top shade keeps the clock readable on bright artwork. -->
                <Rectangle Fill="{DynamicResource BpHeroTopFadeBrush}" />

                <!-- Bottom shade blends the banner into the carousel. -->
                <Rectangle Fill="{DynamicResource BpHeroBottomFadeBrush}" />

                <!-- Clock and settings -->
                <StackPanel Margin="0,26,30,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               FontSize="19"
                               Foreground="{DynamicResource BpTextBrush}"
                               Text="{Binding ClockText}" />
                    <Button Click="Settings_Click"
                            Style="{DynamicResource BpIconButton}"
                            ToolTip="{DynamicResource Loc.Nav.Settings}">
                        <ui:SymbolIcon FontSize="18"
                                       Foreground="{DynamicResource BpTextBrush}"
                                       Symbol="Settings24" />
                    </Button>
                </StackPanel>

                <!-- Grouping: fixed to the hero, independent of the game text. -->
                <StackPanel Margin="56,84,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <!-- LB/RB cycle, pills also click with the mouse. -->
                        <Grid Width="34"
                              Height="26"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center">
                            <Path Data="{StaticResource BpGlyphBumper}"
                                  Fill="{DynamicResource BpHeroPanelBrush}"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource BpBorderBrush}"
                                  StrokeThickness="1" />
                            <TextBlock Style="{StaticResource BpShoulderText}" Text="LB" />
                        </Grid>

                        <Border Padding="5"
                                Background="{DynamicResource BpHeroPanelBrush}"
                                CornerRadius="20">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BpGroupAllButton"
                                             Checked="GroupPill_Checked"
                                             Content="{DynamicResource Loc.BP.GroupAll}"
                                             GroupName="BpGrouping"
                                             Style="{StaticResource BpGroupPill}"
                                             Tag="None" />
                                <RadioButton x:Name="BpGroupAlphaButton"
                                             Checked="GroupPill_Checked"
                                             Content="{DynamicResource Loc.BP.GroupAlpha}"
                                             GroupName="BpGrouping"
                                             Style="{StaticResource BpGroupPill}"
                                             Tag="Alphabet" />
                                <RadioButton x:Name="BpGroupGenreButton"
                                             Checked="GroupPill_Checked"
                                             Content="{DynamicResource Loc.BP.GroupGenre}"
                                             GroupName="BpGrouping"
                                             Style="{StaticResource BpGroupPill}"
                                             Tag="Genre" />
                            </StackPanel>
                        </Border>

                        <Grid Width="34"
                              Height="26"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center">
                            <Path Data="{StaticResource BpGlyphBumper}"
                                  Fill="{DynamicResource BpHeroPanelBrush}"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource BpBorderBrush}"
                                  StrokeThickness="1" />
                            <TextBlock Style="{StaticResource BpShoulderText}" Text="RB" />
                        </Grid>
                </StackPanel>

                <!-- Game information -->
                <StackPanel Margin="56,0,56,42"
                             MaxWidth="900"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="54"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BpTextBrush}"
                               Text="{Binding SelectedTitle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />

                    <Border Margin="2,14,0,0"
                            Padding="18,14"
                            HorizontalAlignment="Left"
                            MaxWidth="820"
                            Background="{DynamicResource BpHeroPanelBrush}"
                            BorderThickness="0"
                            CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGenres}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BpAccentBrush}"
                                       Text="{Binding SelectedGenres}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGenres}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="0,8,0,0"
                                       MaxWidth="760"
                                       MaxHeight="66"
                                       FontSize="14.5"
                                       Foreground="{DynamicResource BpTextBrush}"
                                       Text="{Binding SelectedDescription}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Click="Play_Click"
                                Style="{DynamicResource BpPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="16"
                                               Foreground="{DynamicResource BpAccentForegroundBrush}"
                                               Symbol="Play24" />
                                <TextBlock Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource Loc.BP.Play}" />
                            </StackPanel>
                        </Button>

                        <Button Margin="12,0,0,0"
                                Click="Details_Click"
                                Style="{DynamicResource BpSecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="16"
                                               Foreground="{DynamicResource BpTextBrush}"
                                               Symbol="Info24" />
                                <TextBlock Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource Loc.BP.Details}" />
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Played time: a flat grey chip under the actions. -->
                    <Border Margin="0,14,0,0"
                            Padding="12,7"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource BpCardBrush}"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlaytime}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{Binding PlaytimePillText}" />
                    </Border>
                </StackPanel>

                <!-- Empty library -->
                <Border Background="{DynamicResource BpBackgroundBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGames}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon FontSize="46"
                                       Foreground="{DynamicResource BpTextMutedBrush}"
                                       Symbol="Games24" />
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BpTextBrush}"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   MaxWidth="480"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{Binding EmptyText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Carousel -->

            <Grid Grid.Row="1" Margin="56,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,56,10">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BpTextBrush}"
                               Text="{Binding ListTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenreGrouping}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="0,0,64,0"
                            Padding="6,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BpHeroPanelBrush}"
                            BorderBrush="{DynamicResource BpAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenreGrouping}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Loc.BP.PrevGenre}"
                                Click="GenrePrev_Click"
                                Style="{StaticResource BpArrowButton}"
                                ToolTip="{DynamicResource Loc.BP.PrevGenre}">
                            <ui:SymbolIcon FontSize="14"
                                           Foreground="{DynamicResource BpTextBrush}"
                                           Symbol="ChevronLeft24" />
                        </Button>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="3"
                                    Height="18"
                                    Margin="2,0,10,0"
                                    Background="{DynamicResource BpAccentBrush}"
                                    CornerRadius="2" />
                            <ui:SymbolIcon FontSize="15"
                                           Foreground="{DynamicResource BpAccentBrush}"
                                           Symbol="Grid24" />
                            <TextBlock Margin="8,0,14,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BpAccentBrush}"
                                       Text="{DynamicResource Loc.BP.GroupGenre}" />
                        </StackPanel>

                        <ListBox x:Name="GenreBar"
                                 Grid.Column="2"
                                 Height="32"
                                 MaxWidth="1000"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 ItemsSource="{Binding GenreFilters}"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectedItem="{Binding SelectedGenreFilter, Mode=TwoWay}"
                                 SelectionChanged="GenreBar_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource BpGenrePill}" TargetType="ListBoxItem" />
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Button Grid.Column="3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Loc.BP.NextGenre}"
                                Click="GenreNext_Click"
                                Style="{StaticResource BpArrowButton}"
                                ToolTip="{DynamicResource Loc.BP.NextGenre}">
                            <ui:SymbolIcon FontSize="14"
                                           Foreground="{DynamicResource BpTextBrush}"
                                           Symbol="ChevronRight24" />
                        </Button>
                        </Grid>
                    </Border>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource BpTextMutedBrush}"
                               Text="{Binding CounterText}" />
                </Grid>

                <ListBox x:Name="GamesList"
                         Grid.Row="1"
                         Height="404"
                         Margin="-16,0,0,0"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ItemsSource="{Binding Games}"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                         SelectionChanged="GamesList_SelectionChanged"
                         VerticalContentAlignment="Center"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=GenreBar}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel Width="180"
                                                    Margin="16,38,6,16"
                                                    RenderTransformOrigin="0.5,0.5">
                                            <StackPanel.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                            </StackPanel.RenderTransform>

                                            <Border x:Name="Frame"
                                                    Height="270"
                                                    Background="{DynamicResource BpCardBrush}"
                                                    BorderBrush="{DynamicResource BpCardStrokeBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="12">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="34"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BpTextMutedBrush}"
                                                               Text="{Binding Initials}" />

                                                    <!-- RadiusX/Y clips the artwork, so a
                                                         scaled card never shows square
                                                         corners outside the rounded frame. -->
                                                    <Rectangle RadiusX="10"
                                                               RadiusY="10"
                                                               Stretch="Fill">
                                                        <Rectangle.Fill>
                                                            <ImageBrush AlignmentX="Center"
                                                                        AlignmentY="Center"
                                                                        ImageSource="{Binding Cover}"
                                                                        Stretch="UniformToFill" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="Caption"
                                                       Margin="2,11,0,0"
                                                       MaxHeight="44"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource BpTextMutedBrush}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BpAccentBrush}" />
                                                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="Frame" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="22"
                                                                          Direction="0"
                                                                          Opacity="0.5"
                                                                          ShadowDepth="0"
                                                                          Color="#A5F26B" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Panel.ZIndex" Value="2" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.05"
                                                                             Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.05"
                                                                             Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1"
                                                                             Duration="0:0:0.16" />
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1"
                                                                             Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Compact grid: Down opens it, Up on the first row returns. -->
                <ListBox x:Name="GamesGrid"
                         Grid.Row="1"
                         Height="446"
                         Padding="0,2,0,6"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ItemsSource="{Binding Games}"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                         SelectionChanged="GamesGrid_SelectionChanged">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=GenreBar}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="140" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel Margin="5,4,5,8">
                                            <Border x:Name="Frame"
                                                    Height="170"
                                                    Background="{DynamicResource BpCardBrush}"
                                                    BorderBrush="{DynamicResource BpCardStrokeBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="10"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="GridCardLift" Y="0" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BpTextMutedBrush}"
                                                               Text="{Binding Initials}" />

                                                    <Rectangle RadiusX="8"
                                                               RadiusY="8"
                                                               Stretch="Fill">
                                                        <Rectangle.Fill>
                                                            <ImageBrush AlignmentX="Center"
                                                                        AlignmentY="Center"
                                                                        ImageSource="{Binding Cover}"
                                                                        Stretch="UniformToFill" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="Caption"
                                                       Margin="1,6,1,0"
                                                       MaxHeight="30"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource BpTextMutedBrush}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BpAccentBrush}" />
                                                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="Frame" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16"
                                                                          Direction="0"
                                                                          Opacity="0.45"
                                                                          ShadowDepth="0"
                                                                          Color="#A5F26B" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Panel.ZIndex" Value="2" />

                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GridCardLift"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="-4"
                                                                             Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>

                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GridCardLift"
                                                                             Storyboard.TargetProperty="Y"
                                                                             To="0"
                                                                             Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BpTextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- The last rows of the banner can pick up a one-pixel seam on
                 scaled displays; this strip is drawn above everything. -->
            <Rectangle Grid.Row="0"
                       Height="8"
                       Margin="0,0,0,-4"
                       VerticalAlignment="Bottom"
                       Fill="{DynamicResource BpBackgroundBrush}"
                       IsHitTestVisible="False"
                       Panel.ZIndex="99" />

            <!-- Control hints -->

            <Grid Grid.Row="2" Height="62" Margin="56,10,56,16">
                <Grid VerticalAlignment="Center">
                    <StackPanel x:Name="KeyboardHints" Orientation="Horizontal">
                        <Border Style="{DynamicResource BpKeyCap}">
                            <Path Data="{StaticResource BpGlyphSwap}" Style="{StaticResource BpHintGlyph}" />
                        </Border>
                        <TextBlock Margin="8,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Hint.Move}" />

                        <Border Style="{DynamicResource BpKeyCap}">
                            <Path Data="{StaticResource BpGlyphEnter}" Style="{StaticResource BpHintGlyph}" />
                        </Border>
                        <TextBlock Margin="8,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Play}" />

                        <Border Style="{DynamicResource BpKeyCap}">
                            <Path Data="{StaticResource BpGlyphSpace}" Style="{StaticResource BpHintGlyph}" />
                        </Border>
                        <TextBlock Margin="8,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Details}" />

                        <Border Style="{DynamicResource BpKeyCap}">
                            <Path Data="{StaticResource BpGlyphDown}" Style="{StaticResource BpHintGlyph}" />
                        </Border>
                        <TextBlock Margin="8,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Hint.Grid}" />

                        <Border Style="{DynamicResource BpKeyCap}">
                            <Path Data="{StaticResource BpGlyphExit}" Style="{StaticResource BpHintGlyph}" />
                        </Border>
                        <TextBlock Margin="8,0,0,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Hint.Exit}" />
                    </StackPanel>

                    <StackPanel x:Name="PadHints"
                                Visibility="Collapsed"
                                Orientation="Horizontal">
                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Style="{StaticResource PadBadgeText}" Text="A" />
                        </Border>
                        <TextBlock Margin="0,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Play}" />

                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Style="{StaticResource PadBadgeText}" Text="X" />
                        </Border>
                        <TextBlock Margin="0,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Details}" />

                        <Border Style="{StaticResource PadBadge}">
                            <Path Data="{StaticResource BpGlyphDown}" Style="{StaticResource BpPadGlyph}" />
                        </Border>
                        <TextBlock Margin="0,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Hint.Grid}" />

                        <Border Style="{StaticResource PadBadge}">
                            <Path Data="{StaticResource BpGlyphMenu}" Style="{StaticResource BpPadGlyph}" />
                        </Border>
                        <TextBlock Margin="0,0,18,0"
                                   Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Menu}" />

                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Style="{StaticResource PadBadgeText}" Text="B" />
                        </Border>
                        <TextBlock Style="{DynamicResource BpHintText}"
                                   Text="{DynamicResource Loc.BP.Hint.Exit}" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- =========================== Details panel ======================== -->

        <Grid x:Name="DetailsOverlay"
              Grid.ColumnSpan="2"
              Background="{DynamicResource BpScrimBrush}"
              Visibility="Collapsed"
              MouseLeftButtonDown="DetailsOverlay_MouseLeftButtonDown">
            <Border Width="460"
                    Margin="0,40,40,40"
                    Padding="34,32"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource BpPanelBrush}"
                    BorderBrush="{DynamicResource BpBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{DynamicResource Loc.BP.Details.Title}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BpTextBrush}"
                                   Text="{Binding SelectedTitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,26,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{DynamicResource Loc.BP.Details.Playtime}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="16"
                                   Foreground="{DynamicResource BpTextBrush}"
                                   Text="{Binding SelectedPlaytimeText}" />

                        <TextBlock Margin="0,20,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource BpTextMutedBrush}"
                                   Text="{DynamicResource Loc.BP.Details.Path}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource BpTextBrush}"
                                   Text="{Binding SelectedFolder}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Click="CloseDetails_Click"
                            Style="{DynamicResource BpSecondaryButton}">
                        <TextBlock Text="{DynamicResource Loc.BP.Close}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== Veil ============================== -->

        <!-- Covers the window while the mode changes, then fades out. -->
        <Border x:Name="Veil"
                Grid.ColumnSpan="2"
                Panel.ZIndex="10"
                Background="{DynamicResource BpBackgroundBrush}"
                IsHitTestVisible="False"
                Opacity="0" />

        <!-- Console-style brand animation played on every entrance. -->
        <Grid x:Name="IntroLogo"
              Grid.ColumnSpan="2"
              Panel.ZIndex="11"
              Background="{DynamicResource BpBackgroundBrush}"
              IsHitTestVisible="False"
              Opacity="0"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="108"
                        Height="108"
                        Background="{DynamicResource LogoBrush}"
                        CornerRadius="30"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="IntroLogoScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="46"
                                          Direction="270"
                                          Opacity="0.55"
                                          ShadowDepth="0"
                                          Color="#8CE85B" />
                    </Border.Effect>
                    <ui:SymbolIcon FontSize="54"
                                   Foreground="#13200C"
                                   Symbol="Gamepad24" />
                </Border>

                <TextBlock Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BpTextBrush}"
                           Text="BagaGame" />

                <TextBlock Margin="1,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BpTextMutedBrush}"
                           Text="GAME LAUNCHER" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
