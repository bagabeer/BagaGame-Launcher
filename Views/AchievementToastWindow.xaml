<Window x:Class="BagaGame.Views.AchievementToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        Height="104"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Opacity="0"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Border x:Name="Card"
            Margin="12"
            Padding="12"
            Background="#F21A1A1A"
            BorderBrush="{DynamicResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AccentStrip"
                    Width="3"
                    Margin="0,2,9,2"
                    Background="#A5F26B"
                    CornerRadius="2" />

            <Border x:Name="IconFrame"
                    Grid.Column="1"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#14FFFFFF"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    ClipToBounds="True">
                <Image x:Name="IconImage"
                       Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
                <TextBlock x:Name="BodyText"
                           Margin="0,3,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
