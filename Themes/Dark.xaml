<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Surfaces ============================= -->

    <SolidColorBrush x:Key="WindowTintBrush" Color="#F21A1A1A" />
    <SolidColorBrush x:Key="CardFillBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CardFillHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeHoverBrush" Color="#66A5F26B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TileFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileFillHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ChipFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="PosterStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="IconSoftBrush" Color="#33FFFFFF" />

    <!-- ================================ Text ============================== -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#787878" />

    <!-- =============================== Accent ============================= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#A5F26B" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#BDFF8A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1AA5F26B" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#59A5F26B" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101A0C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#63DE7C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8C15A" />

    <!-- ============================== Overlays ============================ -->

    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="DialogFillBrush" Color="#F2242424" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FieldFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FieldStrokeBrush" Color="#26FFFFFF" />

    <!-- ============================= Gradients ============================ -->

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#CBFF95" />
        <GradientStop Offset="1" Color="#79D948" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverPlaceholderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2C2C2C" />
        <GradientStop Offset="1" Color="#171717" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FooterFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#001A1A1A" />
        <GradientStop Offset="0.55" Color="#E61A1A1A" />
        <GradientStop Offset="1" Color="#F21A1A1A" />
    </LinearGradientBrush>

</ResourceDictionary>
