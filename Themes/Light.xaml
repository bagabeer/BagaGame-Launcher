<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Surfaces ============================= -->

    <SolidColorBrush x:Key="WindowTintBrush" Color="#F2D8D9D4" />
    <SolidColorBrush x:Key="CardFillBrush" Color="#F2F3F3F0" />
    <SolidColorBrush x:Key="CardFillHoverBrush" Color="#FFF7F7F4" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CardStrokeHoverBrush" Color="#803F7A16" />
    <SolidColorBrush x:Key="DividerBrush" Color="#12000000" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#08000000" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#0E000000" />
    <SolidColorBrush x:Key="TileFillBrush" Color="#08000000" />
    <SolidColorBrush x:Key="TileFillHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="ChipFillBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PosterStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#33000000" />
    <SolidColorBrush x:Key="IconSoftBrush" Color="#26000000" />

    <!-- ================================ Text ============================== -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A7A7A" />

    <!-- =============================== Accent ============================= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#3F7A16" />
    <SolidColorBrush x:Key="AccentTranslucentBrush" Color="#B33F7A16" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#4E8F20" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3F7A16" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#663F7A16" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#EDEDE9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A3D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A86B00" />

    <!-- ============================== Overlays ============================ -->

    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="DialogFillBrush" Color="#FFF1F1EE" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="FieldFillBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="FieldStrokeBrush" Color="#1F000000" />

    <!-- ============================== Controls ============================ -->

    <SolidColorBrush x:Key="ControlFillBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PopupFillBrush" Color="#FFF2F2EF" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66000000" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />

    <!-- ============================= Gradients ============================ -->

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#CBFF95" />
        <GradientStop Offset="1" Color="#79D948" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverPlaceholderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E7E7E7" />
        <GradientStop Offset="1" Color="#D9D9D9" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FooterFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00D8D9D4" />
        <GradientStop Offset="0.55" Color="#E6D8D9D4" />
        <GradientStop Offset="1" Color="#F2D8D9D4" />
    </LinearGradientBrush>

    <!-- ============================ Big Picture =========================== -->

    <SolidColorBrush x:Key="BpBackgroundBrush" Color="#D8D9D4" />
    <SolidColorBrush x:Key="BpSidebarBrush" Color="#CDCEC9" />
    <SolidColorBrush x:Key="BpCardBrush" Color="#EDEDE9" />
    <SolidColorBrush x:Key="BpTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="BpTextMutedBrush" Color="#5A5F66" />
    <SolidColorBrush x:Key="BpDescriptionBrush" Color="#474C45" />
    <SolidColorBrush x:Key="BpBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="BpCardStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="BpDividerBrush" Color="#12000000" />
    <SolidColorBrush x:Key="BpKeyCapBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="BpKeyCapStrokeBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="BpNavHoverBrush" Color="#08000000" />
    <SolidColorBrush x:Key="BpAccentBrush" Color="#3F7A16" />
    <SolidColorBrush x:Key="BpAccentHoverBrush" Color="#4E8F20" />
    <SolidColorBrush x:Key="BpAccentForegroundBrush" Color="#EDEDE9" />
    <SolidColorBrush x:Key="BpAccentSoftBrush" Color="#1F3F7A16" />
    <SolidColorBrush x:Key="BpSecondaryFillBrush" Color="#EDEDE9" />
    <SolidColorBrush x:Key="BpSecondaryHoverBrush" Color="#DFE0DB" />
    <SolidColorBrush x:Key="BpScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="BpPanelBrush" Color="#E2E2DD" />
    <SolidColorBrush x:Key="BpHeroTextBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="BpHeroMutedBrush" Color="#D6DBD4" />
    <SolidColorBrush x:Key="BpHeroAccentBrush" Color="#A5F26B" />
    <SolidColorBrush x:Key="BpPadBadgeBrush" Color="#1A1C18" />
    <SolidColorBrush x:Key="BpPadBadgeTextBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AccentRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8FD456" />
        <GradientStop Offset="0.55" Color="#3F7A16" />
        <GradientStop Offset="1" Color="#2F5E10" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BpHeroLeftFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#B3D8D9D4" />
        <GradientStop Offset="0.35" Color="#59D8D9D4" />
        <GradientStop Offset="0.6" Color="#00D8D9D4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BpHeroTopFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33D8D9D4" />
        <GradientStop Offset="0.2" Color="#00D8D9D4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BpHeroBottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00D8D9D4" />
        <GradientStop Offset="0.78" Color="#33D8D9D4" />
        <GradientStop Offset="1" Color="#FFD8D9D4" />
    </LinearGradientBrush>

</ResourceDictionary>
