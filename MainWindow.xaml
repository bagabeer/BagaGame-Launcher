<ui:BagaWindow
    x:Class="BagaGame.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:BagaGame.Controls"
    Title="BagaGame"
    Width="1320"
    Height="880"
    MinWidth="1040"
    MinHeight="660"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/bagagame.ico"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <ui:BagaWindow.Resources>

        <!-- Shown only for settings rows that have a non-default value. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ============================== Styles =============================== -->

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Sidebar navigation item: hover pill + accent rail + checked state. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover"
                                    Background="Transparent"
                                    CornerRadius="8" />
                            <Border x:Name="Active"
                                    Background="{DynamicResource NavActiveBrush}"
                                    CornerRadius="8"
                                    Opacity="0" />
                            <Border x:Name="Rail"
                                    Width="3"
                                    Height="18"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                            <Border x:Name="FocusRing"
                                    Margin="1"
                                    BorderBrush="{DynamicResource AccentStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Opacity="0" />
                            <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Active" Property="Opacity" Value="1" />
                                <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid / list toggle. -->
        <Style x:Key="ViewToggleStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    BorderBrush="{DynamicResource AccentStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Library grouping pill ("Все / А–Я / Жанры / Серии"). -->
        <!-- Minimal chevron used to expand small lists in Settings. -->
        <Style x:Key="ChevronToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource TileFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileFillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupToggleStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    BorderBrush="{DynamicResource AccentStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lime call-to-action (used on the scanning page). -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status indicator: green when idle, amber while scanning. -->
        <Style x:Key="StatusHaloStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Opacity" Value="0.18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="7"
                                      Direction="270"
                                      Opacity="0.9"
                                      ShadowDepth="0"
                                      Color="#63DE7C" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="7"
                                              Direction="270"
                                              Opacity="0.9"
                                              ShadowDepth="0"
                                              Color="#E8C15A" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ========================= Game card (grid) ========================= -->

        <DataTemplate x:Key="GameCardTemplate">
            <Grid x:Name="Card"
                  Width="200"
                  Margin="0,0,0,22"
                  Background="Transparent"
                  ToolTip="{Binding Title}">
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Click="LaunchGame_Click"
                                  FontWeight="SemiBold"
                                  Header="{DynamicResource Loc.Menu.Launch}"
                                  IsEnabled="{Binding CanLaunch}" />
                        <MenuItem Click="OpenFolder_Click" Header="{DynamicResource Loc.Menu.OpenFolder}" />
                        <MenuItem Click="ReassignGameFolder_Click"
                                  Header="{DynamicResource Loc.Menu.ReassignFolder}"
                                  ToolTip="{DynamicResource Loc.Menu.ReassignFolderTip}"
                                  Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
                        <Separator />
                        <MenuItem Click="RenameGame_Click" Header="{DynamicResource Loc.Menu.Rename}" />
                        <MenuItem Click="RemoveGame_Click"
                                  Header="{DynamicResource Loc.Menu.Hide}"
                                  ToolTip="{DynamicResource Loc.Menu.HideTip}" />
                        <MenuItem Click="DeleteGame_Click"
                                  Header="{DynamicResource Loc.Menu.Delete}"
                                  ToolTip="{DynamicResource Loc.Menu.DeleteTip}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="180"
                      Height="260"
                      HorizontalAlignment="Left"
                      Cursor="Hand"
                      MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PosterLift" Y="0" />
                    </Grid.RenderTransform>

                    <Border x:Name="Poster"
                            Background="{DynamicResource CoverPlaceholderBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PosterShadow"
                                              BlurRadius="22"
                                              Direction="270"
                                              Opacity="0"
                                              ShadowDepth="5"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <!-- Visible until the real cover arrives / when offline. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource IconMutedBrush}"
                                           Text="{Binding Initials}" />
                                <ui:SymbolIcon Margin="0,6,0,0"
                                               Symbol="Games24"
                                               FontSize="13"
                                               Foreground="{DynamicResource IconSoftBrush}"
                                               HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- ImageBrush is clipped by CornerRadius automatically. -->
                            <Border x:Name="CoverLayer" CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush AlignmentX="Center"
                                                AlignmentY="Center"
                                                ImageSource="{Binding Cover}"
                                                Stretch="UniformToFill">
                                        <ImageBrush.RelativeTransform>
                                            <ScaleTransform CenterX="0.5"
                                                            CenterY="0.5"
                                                            ScaleX="1"
                                                            ScaleY="1" />
                                        </ImageBrush.RelativeTransform>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <Border BorderBrush="{DynamicResource PosterStrokeBrush}" BorderThickness="1" CornerRadius="8" />

                            <!-- The drive is offline: the record is kept, the
                                 card explains why it cannot be started. -->
                            <Border Margin="8"
                                    Padding="7,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#D9B45309"
                                    CornerRadius="6"
                                    ToolTip="{Binding PathUnavailableTip}"
                                    Visibility="{Binding IsPathUnavailable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PathUnavailableText}" />
                            </Border>

                            <!-- Small play hint that appears on hover. -->
                            <Border x:Name="PlayBadge"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,10,10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#B3000000"
                                    CornerRadius="18"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <ui:SymbolIcon Symbol="Play24"
                                               FontSize="15"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>

                            <!-- Played time: terse hours on the poster, exact in the tooltip. -->
                            <Border Margin="10,0,0,10"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#B3000000"
                                    CornerRadius="6"
                                    ToolTip="{Binding PlaytimeTooltip}"
                                    Visibility="{Binding HasPlaytime, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PlaytimeText}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Width="180"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           LineHeight="17"
                           MaxHeight="36"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </Grid>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Poster" Property="BorderBrush" Value="{DynamicResource CardStrokeHoverBrush}" />

                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PosterLift"
                                                 Storyboard.TargetProperty="Y"
                                                 To="-4"
                                                 Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Poster"
                                                 Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 To="0.55"
                                                 Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PosterLift"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0"
                                                 Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Poster"
                                                 Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 To="0"
                                                 Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="PlayBadge"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ========================= Game row (list) ========================== -->

        <DataTemplate x:Key="GameRowTemplate">
            <Border x:Name="Row"
                    Height="88"
                    Margin="0,0,8,8"
                    Padding="10"
                    Background="{DynamicResource CardFillBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                    ToolTip="{Binding Title}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Click="LaunchGame_Click"
                                  FontWeight="SemiBold"
                                  Header="{DynamicResource Loc.Menu.Launch}"
                                  IsEnabled="{Binding CanLaunch}" />
                        <MenuItem Click="OpenFolder_Click" Header="{DynamicResource Loc.Menu.OpenFolder}" />
                        <MenuItem Click="ReassignGameFolder_Click"
                                  Header="{DynamicResource Loc.Menu.ReassignFolder}"
                                  ToolTip="{DynamicResource Loc.Menu.ReassignFolderTip}"
                                  Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
                        <Separator />
                        <MenuItem Click="RenameGame_Click" Header="{DynamicResource Loc.Menu.Rename}" />
                        <MenuItem Click="RemoveGame_Click"
                                  Header="{DynamicResource Loc.Menu.Hide}"
                                  ToolTip="{DynamicResource Loc.Menu.HideTip}" />
                        <MenuItem Click="DeleteGame_Click"
                                  Header="{DynamicResource Loc.Menu.Delete}"
                                  ToolTip="{DynamicResource Loc.Menu.DeleteTip}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="48" Height="68">
                        <Border Background="{DynamicResource CoverPlaceholderBrush}" CornerRadius="6" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource IconSoftBrush}"
                                       Text="{Binding Initials}" />
                            <ui:SymbolIcon Margin="0,3,0,0"
                                           Symbol="Games24"
                                           FontSize="9"
                                           Foreground="{DynamicResource IconSoftBrush}"
                                           HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush AlignmentX="Center"
                                            AlignmentY="Center"
                                            ImageSource="{Binding Cover}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding Details}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Margin="0,0,10,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ChipFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ToolTip="{Binding PlaytimeTooltip}"
                                Visibility="{Binding HasPlaytime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding PlaytimeText}" />
                        </Border>
                        <ui:SymbolIcon Margin="0,0,6,0"
                                       Symbol="ChevronRight24"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardFillHoverBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardStrokeHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Header of a library group (letter / genre / series + count). -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Grid Margin="0,2,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Name}" />
                    <Border Margin="9,1,0,0"
                            Padding="7,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ChipFillBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ItemCount}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============================ Panels ================================ -->

        <ItemsPanelTemplate x:Key="GamesGridPanel">
            <WrapPanel ItemWidth="200" ItemHeight="332" Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="GamesListPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

    </ui:BagaWindow.Resources>

    <Grid x:Name="Root" Background="{DynamicResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Draggable caption area; the window buttons live in TitleBar.xaml. -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Grid.ColumnSpan="2"
                     Height="48"
                     Background="Transparent" />

        <!-- ============================ Sidebar ============================== -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,2,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="4,2,0,0" Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            Background="{DynamicResource LogoBrush}"
                            CornerRadius="11">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Direction="270"
                                              Opacity="0.32"
                                              ShadowDepth="0"
                                              Color="#8CE85B" />
                        </Border.Effect>
                        <ui:SymbolIcon Symbol="Games24"
                                       FontSize="22"
                                       Foreground="#13200C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="BagaGame" />
                        <TextBlock Margin="1,3,0,0"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="GAME LAUNCHER" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <TextBlock Margin="12,0,0,8"
                               Style="{StaticResource EyebrowStyle}"
                               Text="{DynamicResource Loc.Nav.Header}" />

                    <RadioButton x:Name="LibraryNav"
                                 AutomationProperties.Name="{DynamicResource Loc.Settings.Library}"
                                 Checked="Nav_Checked"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavItemStyle}"
                                 Tag="Library">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Symbol="Library24" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       Text="{DynamicResource Loc.Settings.Library}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ScanNav"
                                 AutomationProperties.Name="{DynamicResource Loc.Nav.Scan}"
                                 Checked="Nav_Checked"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}"
                                 Tag="Scan">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Symbol="Search24" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       Text="{DynamicResource Loc.Nav.Scan}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SettingsNav"
                                 AutomationProperties.Name="{DynamicResource Loc.Nav.Settings}"
                                 Checked="Nav_Checked"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}"
                                 Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Symbol="Settings24" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       Text="{DynamicResource Loc.Nav.Settings}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Status -->
                <Border Grid.Row="2"
                        Padding="12,11"
                        Background="{DynamicResource CardFillBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="10"
                                  Height="10"
                                  Margin="0,3,0,0"
                                  VerticalAlignment="Top">
                                <Ellipse Width="10"
                                         Height="10"
                                         Style="{StaticResource StatusHaloStyle}" />
                                <Ellipse Width="6"
                                         Height="6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource StatusDotStyle}" />
                            </Grid>

                            <TextBlock Margin="9,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding StatusText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Margin="19,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding GamesCountText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =========================== Main area ============================= -->

        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Library page -->
            <Grid x:Name="LibraryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="36,26,32,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{DynamicResource Loc.Settings.Library}" />
                        <TextBlock Margin="1,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding LibrarySummary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="AddGameButton"
                                AutomationProperties.Name="{DynamicResource Loc.Library.AddGame}"
                                Click="AddGame_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="{DynamicResource Loc.Library.AddGameTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14"
                                               Foreground="{DynamicResource AccentForegroundBrush}"
                                               Symbol="Add24" />
                                <TextBlock Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource Loc.Library.AddGame}" />
                            </StackPanel>
                        </Button>

                        <Border Margin="10,0,0,0"
                                Padding="3"
                                Background="{DynamicResource ChipFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="GridViewButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.Grid}"
                                             Checked="ViewMode_Checked"
                                             GroupName="ViewMode"
                                             IsChecked="True"
                                             Style="{StaticResource ViewToggleStyle}"
                                             ToolTip="{DynamicResource Loc.Library.Grid}">
                                    <ui:SymbolIcon FontSize="15"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Symbol="Grid24" />
                                </RadioButton>
                                <RadioButton x:Name="ListViewButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.List}"
                                             Checked="ViewMode_Checked"
                                             GroupName="ViewMode"
                                             Style="{StaticResource ViewToggleStyle}"
                                             ToolTip="{DynamicResource Loc.Library.List}">
                                    <ui:SymbolIcon FontSize="15"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Symbol="List24" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Search and grouping -->
                <Grid Grid.Row="1" Margin="36,0,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="270"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="{DynamicResource FieldFillBrush}"
                            BorderBrush="{DynamicResource FieldStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Symbol="Search24" />

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Margin="3,0,0,0"
                                     Padding="5,0,4,0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource Loc.Library.SearchHint}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FocusVisualStyle="{x:Null}"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     Style="{x:Null}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="{DynamicResource Loc.Library.SearchPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ui:BagaButton Grid.Column="2"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,6,0"
                                       Padding="0"
                                       Appearance="Secondary"
                                       AutomationProperties.Name="{DynamicResource Loc.Library.ClearSearch}"
                                       Click="ClearSearch_Click"
                                       CornerRadius="6"
                                       ToolTip="{DynamicResource Loc.Library.ClearSearch}"
                                       Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon FontSize="10" Symbol="Dismiss24" />
                            </ui:BagaButton>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding VisibleCountText}"
                                   Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}" />

                        <Border Padding="3"
                                Background="{DynamicResource ChipFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="GroupAllButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.GroupNone}"
                                             Checked="GroupMode_Checked"
                                             Content="{DynamicResource Loc.Library.GroupAll}"
                                             GroupName="Grouping"
                                             IsChecked="True"
                                             Style="{StaticResource GroupToggleStyle}"
                                             Tag="None"
                                             ToolTip="{DynamicResource Loc.Library.GroupNoneTip}" />
                                <RadioButton x:Name="GroupAlphaButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.GroupAlpha}"
                                             Checked="GroupMode_Checked"
                                             Content="{DynamicResource Loc.Library.GroupAlphaShort}"
                                             GroupName="Grouping"
                                             Style="{StaticResource GroupToggleStyle}"
                                             Tag="Alphabet"
                                             ToolTip="{DynamicResource Loc.Library.GroupAlphaTip}" />
                                <RadioButton x:Name="GroupGenreButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.GroupGenre}"
                                             Checked="GroupMode_Checked"
                                             Content="{DynamicResource Loc.Library.GroupGenreShort}"
                                             GroupName="Grouping"
                                             Style="{StaticResource GroupToggleStyle}"
                                             Tag="Genre"
                                             ToolTip="{DynamicResource Loc.Library.GroupGenreTip}" />
                                <RadioButton x:Name="GroupSeriesButton"
                                             AutomationProperties.Name="{DynamicResource Loc.Library.GroupSeries}"
                                             Checked="GroupMode_Checked"
                                             Content="{DynamicResource Loc.Library.GroupSeriesShort}"
                                             GroupName="Grouping"
                                             Style="{StaticResource GroupToggleStyle}"
                                             Tag="Series"
                                             ToolTip="{DynamicResource Loc.Library.GroupSeriesTip}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="ScrollHost"
                                  Style="{StaticResource OverlayScrollViewer}"
                                  Padding="36,0,20,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GamesItems"
                                      ItemsSource="{Binding GamesView}"
                                      ItemTemplate="{StaticResource GameCardTemplate}"
                                      ItemsPanel="{StaticResource GamesGridPanel}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleGames}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="18">
                            <ui:SymbolIcon Symbol="Games24"
                                           FontSize="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Bottom action bar -->
                <Grid Grid.Row="3" Height="84">
                    <Border Background="{DynamicResource FooterFadeBrush}" IsHitTestVisible="False" />
                    <ui:BagaButton x:Name="RescanButton"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="18,9"
                               Appearance="Secondary"
                               AutomationProperties.Name="{DynamicResource Loc.Library.Rescan}"
                               Click="Rescan_Click"
                               CornerRadius="8"
                               FontSize="12.5"
                               IsEnabled="{Binding CanRescan}"
                               ToolTip="{DynamicResource Loc.Library.RescanTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="RefreshIcon"
                                           Width="16"
                                           Height="16"
                                           FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           RenderTransformOrigin="0.5,0.5"
                                           Symbol="ArrowClockwise24">
                                <ui:SymbolIcon.RenderTransform>
                                    <RotateTransform x:Name="RefreshRotation" Angle="0" />
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                            <TextBlock Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource Loc.Library.Rescan}" />
                        </StackPanel>
                    </ui:BagaButton>
                </Grid>
            </Grid>

            <!-- Scanning page -->
            <Grid x:Name="ScanPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="36,26,32,18">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource Loc.Nav.Scan}" />
                    <TextBlock Margin="1,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Loc.Scan.Subtitle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource OverlayScrollViewer}"
                              Padding="36,0,32,24"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="720" HorizontalAlignment="Left">

                        <Border Padding="26"
                                Background="{DynamicResource CardFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="58"
                                        Height="58"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="15">
                                    <ui:SymbolIcon Symbol="Search24"
                                                   FontSize="25"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource Loc.Scan.Find}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{DynamicResource Loc.Scan.Description}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                        <Button Padding="16,9"
                                                Click="ScanNow_Click"
                                                Content="{DynamicResource Loc.Scan.Now}"
                                                IsEnabled="{Binding CanRescan}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Scan.Duration}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,12,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding ScanInfo}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScanInfo}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="2,24,0,10"
                                   Style="{StaticResource EyebrowStyle}"
                                   Text="{DynamicResource Loc.Scan.Sources}" />

                        <Border Style="{StaticResource PanelCardStyle}" Padding="18,6">
                            <StackPanel>
                                <Grid Height="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="Games24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Steam" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Scan.SteamAll}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{DynamicResource Loc.Scan.Supported}" />
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                <Grid Height="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="Globe24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Epic Games" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Scan.EpicDesc}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{DynamicResource Loc.Scan.Supported}" />
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                <Grid Height="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="Globe24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="GOG Galaxy" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Scan.GogDesc}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{DynamicResource Loc.Scan.Supported}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,24,0,10"
                                   Style="{StaticResource EyebrowStyle}"
                                   Text="{DynamicResource Loc.Scan.Folders}" />

                        <Border Style="{StaticResource PanelCardStyle}" Padding="18,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Folder24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{DynamicResource Loc.Scan.CustomFolders}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{Binding FoldersSummary, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:BagaButton Grid.Column="2"
                                               Padding="12,6"
                                               Appearance="Secondary"
                                               Click="AddFolder_Click"
                                               Content="{DynamicResource Loc.Common.Add}"
                                               CornerRadius="7"
                                               IsEnabled="{Binding CanRescan}" />
                                </Grid>

                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Folders}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFolders}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="40" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding}" />
                                                <ui:BagaButton Grid.Column="1"
                                                           Padding="10,4"
                                                           Appearance="Secondary"
                                                           Click="RemoveFolder_Click"
                                                           Content="{DynamicResource Loc.Common.Remove}"
                                                           CornerRadius="6"
                                                           FontSize="11"
                                                           Tag="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings page -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="36,26,32,18">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource Loc.Nav.Settings}" />
                    <TextBlock Margin="1,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Loc.Settings.Subtitle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource OverlayScrollViewer}"
                              Padding="36,0,32,24"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="720" HorizontalAlignment="Left">

                        <TextBlock Margin="2,0,0,10"
                                   Style="{StaticResource EyebrowStyle}"
                                   Text="{DynamicResource Loc.Settings.Appearance}" />

                        <Border Style="{StaticResource PanelCardStyle}" Padding="18,4">
                            <StackPanel>
                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="WeatherSunny24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.LightTheme}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.LightThemeTip}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ThemeToggle"
                                                     Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="{DynamicResource Loc.Settings.LightTheme}"
                                                     Checked="ThemeToggle_Toggled"
                                                     Unchecked="ThemeToggle_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                <!-- Interface language: swaps Strings.ru.xaml and
                                     Strings.en.xaml without a restart. -->
                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="Globe24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.Language}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.LanguageTip}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Border Padding="3"
                                                Background="{DynamicResource ChipFillBrush}"
                                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="LanguageRuButton"
                                                             AutomationProperties.Name="{DynamicResource Loc.Settings.LanguageRu}"
                                                             Checked="Language_Checked"
                                                             Content="{DynamicResource Loc.Settings.LanguageRu}"
                                                             GroupName="Language"
                                                             Style="{StaticResource GroupToggleStyle}"
                                                             Tag="Russian" />
                                                <RadioButton x:Name="LanguageEnButton"
                                                             AutomationProperties.Name="English"
                                                             Checked="Language_Checked"
                                                             Content="English"
                                                             GroupName="Language"
                                                             Style="{StaticResource GroupToggleStyle}"
                                                             Tag="English" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.DownloadCovers}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.DownloadCoversTip}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding DownloadCovers}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,24,0,10"
                                   Style="{StaticResource EyebrowStyle}"
                                   Text="{DynamicResource Loc.Settings.Library}" />

                        <Border Style="{StaticResource PanelCardStyle}" Padding="18,4">
                            <StackPanel>
                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="Folder24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{DynamicResource Loc.Settings.Cache}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{Binding CoverCacheDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CoverCacheDirectory}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ui:BagaButton Padding="12,6"
                                                   Appearance="Secondary"
                                                   Click="OpenCacheFolder_Click"
                                                   Content="{DynamicResource Loc.Common.Open}"
                                                   CornerRadius="7" />
                                        <ui:BagaButton Margin="8,0,0,0"
                                                   Padding="12,6"
                                                   Appearance="Secondary"
                                                   Click="ChangeCacheFolder_Click"
                                                   Content="{DynamicResource Loc.Common.Change}"
                                                   CornerRadius="7" />
                                        <ui:BagaButton Margin="8,0,0,0"
                                                   Padding="12,6"
                                                   Appearance="Secondary"
                                                   Click="ResetCacheFolder_Click"
                                                   Content="{DynamicResource Loc.Common.Reset}"
                                                   CornerRadius="7"
                                                   ToolTip="{DynamicResource Loc.Settings.CacheTip}"
                                                   Visibility="{Binding IsCustomCoverCache, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TileFillBrush}"
                                            CornerRadius="9">
                                        <ui:SymbolIcon Symbol="EyeOff24"
                                                       FontSize="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{DynamicResource Loc.Settings.Hidden}" />
                                            <ToggleButton x:Name="HiddenExpander"
                                                          Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="{DynamicResource Loc.Settings.HiddenToggle}"
                                                          IsChecked="False"
                                                          Style="{StaticResource ChevronToggleStyle}"
                                                          ToolTip="{DynamicResource Loc.Settings.HiddenToggle}"
                                                          Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="ChevronDown24"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                             Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ToggleButton>
                                        </StackPanel>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{Binding HiddenSummary}" />
                                    </StackPanel>
                                    <ui:BagaButton Grid.Column="2"
                                               Height="28"
                                               MinWidth="0"
                                               Padding="12,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Appearance="Secondary"
                                               AutomationProperties.AutomationId="RestoreAllHiddenButton"
                                               Click="RestoreHidden_Click"
                                               Content="{DynamicResource Loc.Settings.RestoreAll}"
                                               CornerRadius="7"
                                               IsEnabled="{Binding HasHidden}" />
                                </Grid>

                                <!-- Hidden games are restored one by one from this list. -->
                                <ItemsControl Margin="46,0,0,4"
                                              ItemsSource="{Binding HiddenGames}"
                                              Visibility="{Binding IsChecked, ElementName=HiddenExpander, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,1,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Text="{Binding Details}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Details}" />
                                                </StackPanel>
                                                <ui:BagaButton Grid.Column="1"
                                                               Height="26"
                                                               MinWidth="0"
                                                               Padding="10,0"
                                                               VerticalAlignment="Center"
                                                               Appearance="Secondary"
                                                               AutomationProperties.AutomationId="RestoreHiddenItemButton"
                                                               Click="RestoreHiddenGame_Click"
                                                               Content="{DynamicResource Loc.Common.Restore}"
                                                               CornerRadius="6"
                                                               Tag="{Binding Id}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,24,0,10"
                                   Style="{StaticResource EyebrowStyle}"
                                   Text="{DynamicResource Loc.Settings.About}" />

                        <Border Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        Background="{DynamicResource LogoBrush}"
                                        CornerRadius="11">
                                    <ui:SymbolIcon Symbol="Games24"
                                                   FontSize="21"
                                                   Foreground="#13200C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="BagaGame" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding VersionSummary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Add-game overlay (folder or .exe) -->
        <Grid x:Name="AddGameOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="101"
              Background="{DynamicResource OverlayBrush}"
              MouseLeftButtonDown="AddGameOverlay_MouseLeftButtonDown"
              Visibility="Collapsed">
            <Border Width="500"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DialogFillBrush}"
                    BorderBrush="{DynamicResource DialogStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40"
                                      Direction="270"
                                      Opacity="0.5"
                                      ShadowDepth="10"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource Loc.Library.AddGame}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Loc.Add.Description}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <ui:BagaButton Width="212"
                                   Height="72"
                                   Padding="14,10"
                                   Appearance="Secondary"
                                   AutomationProperties.Name="{DynamicResource Loc.Add.Folder}"
                                   Click="AddGameFolder_Click"
                                   CornerRadius="9"
                                   ToolTip="{DynamicResource Loc.Add.FolderTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Symbol="Folder24" />
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource Loc.Add.Folder}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{DynamicResource Loc.Add.FolderAction}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ui:BagaButton>

                        <ui:BagaButton Width="212"
                                   Height="72"
                                   Margin="10,0,0,0"
                                   Padding="14,10"
                                   Appearance="Secondary"
                                   AutomationProperties.Name="{DynamicResource Loc.Add.Exe}"
                                   Click="AddGameExe_Click"
                                   CornerRadius="9"
                                   ToolTip="{DynamicResource Loc.Add.ExeTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Symbol="Games24" />
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource Loc.Add.Exe}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{DynamicResource Loc.Add.ExeAction}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ui:BagaButton>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:BagaButton x:Name="AddGameCancelButton"
                                   Padding="14,7"
                                   Appearance="Secondary"
                                   Click="AddGameCancel_Click"
                                   Content="{DynamicResource Loc.Common.Cancel}"
                                   CornerRadius="7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rename overlay (modal, keeps the window chrome and theme) -->
        <Grid x:Name="RenameOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="{DynamicResource OverlayBrush}"
              MouseLeftButtonDown="RenameOverlay_MouseLeftButtonDown"
              Visibility="Collapsed">
            <Border Width="440"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DialogFillBrush}"
                    BorderBrush="{DynamicResource DialogStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40"
                                      Direction="270"
                                      Opacity="0.5"
                                      ShadowDepth="10"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource Loc.Rename.Title}" />
                    <TextBlock x:Name="RenameSubtitle"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="RenameBox"
                             Height="38"
                             Margin="0,18,0,0"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="{DynamicResource Loc.Rename.Placeholder}"
                             Background="{DynamicResource FieldFillBrush}"
                             BorderBrush="{DynamicResource FieldStrokeBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource AccentBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             KeyDown="RenameBox_KeyDown"
                             MaxLength="120"
                             SelectionBrush="{DynamicResource AccentBrush}" />
                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:BagaButton Margin="0,0,8,0"
                                   Padding="14,7"
                                   Appearance="Secondary"
                                   Click="RenameCancel_Click"
                                   Content="{DynamicResource Loc.Common.Cancel}"
                                   CornerRadius="7" />
                        <ui:BagaButton Padding="14,7"
                                   Appearance="Primary"
                                   Click="RenameSave_Click"
                                   Content="{DynamicResource Loc.Common.Save}"
                                   CornerRadius="7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    <ui:BagaWindow.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </ui:BagaWindow.Triggers>

</ui:BagaWindow>
