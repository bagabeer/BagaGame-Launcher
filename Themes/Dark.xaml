<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Surfaces ============================= -->

    <SolidColorBrush x:Key="WindowTintBrush" Color="#F21A1A1A" />
    <SolidColorBrush x:Key="CardFillBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CardFillHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeHoverBrush" Color="#66A5F26B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TileFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileFillHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ChipFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="PosterStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="IconSoftBrush" Color="#33FFFFFF" />

    <!-- ================================ Text ============================== -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#787878" />

    <!-- =============================== Accent ============================= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#A5F26B" />
    <SolidColorBrush x:Key="AccentTranslucentBrush" Color="#B3A5F26B" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#BDFF8A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1AA5F26B" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#59A5F26B" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101A0C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#63DE7C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8C15A" />

    <!-- ============================== Overlays ============================ -->

    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="DialogFillBrush" Color="#F2242424" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FieldFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FieldStrokeBrush" Color="#26FFFFFF" />

    <!-- ============================== Controls ============================ -->

    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="PopupFillBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />

    <!-- ============================= Gradients ============================ -->

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#CBFF95" />
        <GradientStop Offset="1" Color="#79D948" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverPlaceholderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2C2C2C" />
        <GradientStop Offset="1" Color="#171717" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FooterFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#001A1A1A" />
        <GradientStop Offset="0.55" Color="#E61A1A1A" />
        <GradientStop Offset="1" Color="#F21A1A1A" />
    </LinearGradientBrush>

    <!-- ============================ Big Picture =========================== -->

    <SolidColorBrush x:Key="BpBackgroundBrush" Color="#111315" />
    <SolidColorBrush x:Key="BpSidebarBrush" Color="#17191C" />
    <SolidColorBrush x:Key="BpCardBrush" Color="#1C1F1D" />
    <SolidColorBrush x:Key="BpTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="BpTextMutedBrush" Color="#92969D" />
    <SolidColorBrush x:Key="BpDescriptionBrush" Color="#C6CCC6" />
    <SolidColorBrush x:Key="BpBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BpCardStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BpDividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BpKeyCapBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="BpKeyCapStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BpNavHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BpAccentBrush" Color="#A5F26B" />
    <SolidColorBrush x:Key="BpAccentHoverBrush" Color="#BDFF8A" />
    <SolidColorBrush x:Key="BpAccentForegroundBrush" Color="#101A0C" />
    <SolidColorBrush x:Key="BpAccentSoftBrush" Color="#1FA5F26B" />
    <SolidColorBrush x:Key="BpSecondaryFillBrush" Color="#1B1F1C" />
    <SolidColorBrush x:Key="BpSecondaryHoverBrush" Color="#242924" />
    <SolidColorBrush x:Key="BpScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="BpPanelBrush" Color="#F2171A18" />
    <SolidColorBrush x:Key="BpHeroTextBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="BpHeroMutedBrush" Color="#D6DBD4" />
    <SolidColorBrush x:Key="BpHeroAccentBrush" Color="#A5F26B" />
    <SolidColorBrush x:Key="BpPadBadgeBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="BpPadBadgeTextBrush" Color="#12140F" />

    <LinearGradientBrush x:Key="BpHeroLeftFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#99111315" />
        <GradientStop Offset="0.35" Color="#33111315" />
        <GradientStop Offset="0.6" Color="#00111315" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BpHeroTopFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D111315" />
        <GradientStop Offset="0.2" Color="#00111315" />
        <GradientStop Offset="1" Color="#00111315" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BpHeroBottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00111315" />
        <GradientStop Offset="0.78" Color="#40111315" />
        <GradientStop Offset="1" Color="#FF111315" />
    </LinearGradientBrush>

</ResourceDictionary>
